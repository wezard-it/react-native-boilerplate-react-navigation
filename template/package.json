{
  "name": "projectname",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "run:android": "ENVFILE=.env npx react-native run-android",
    "run:ios": "ENVFILE=.env npx react-native run-ios --simulator=\"iPhone 15 Pro\"",
    "start": "npx react-native start",
    "start:android": "adb reverse tcp:8081 tcp:8081 && npx react-native start",
    "android:bundle:release": "cd android && ./gradlew bundleRelease && cd .. ",
    "android:distribution:release": "cd android && ./gradlew assembleRelease && cd .. ",
    "upgrade:ios": "cd ios && pod install && cd ..",
    "upgrade:android": "cd android && ./gradlew clean --build-cache && cd ..",
    "upgrade:all": "yarn install && yarn upgrade:ios && yarn upgrade:android",
    "upgrade:oss": "yarn upgrade:ios && yarn upgrade:android",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --extendedDiagnostics --noEmit --project .",
    "prepare": "husky install",
    "revert:commit": "git reset --soft HEAD~1",
    "ci:ios:match": "bundle exec fastlane ios match_provisioning_profiles",
    "ci:ios:bump": "bundle exec fastlane ios bump",
    "ci:ios:deploy-staging": "bundle exec fastlane ios appdistribution",
    "ci:android:bump": "bundle exec fastlane android bump",
    "ci:android:deploy-staging": "bundle exec fastlane android appdistribution",
    "watchman:clean": "watchman watch-del-all",
    "pods": "npx pod-install",
    "postinstall": "yarn pods && yarn upgrade:android",
    "build:android": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle",
    "translations:sort": "node ./scripts/sort_translations.js"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "boilerplate"
  ],
  "repository": "https://github.com/wezard-it/react-native-boilerplate.git",
  "author": "Wekouri Eric <eric.wekouri@gmail.com> (https://developers.westudents.it)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wezard-it/react-native-boilerplate/issues"
  },
  "homepage": "https://github.com/wezard-it/react-native-boilerplate#readme",
