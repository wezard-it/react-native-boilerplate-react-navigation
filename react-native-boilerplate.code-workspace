{
  "folders": [
    {
      "name": "Root",
      "path": "."
    },
    {
      "name": "Template",
      "path": "./template"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/Pods": true,
      "**/build": true,
      "**/.gradle": true,
      "**/android/app/build": true,
      "**/ios/build": true,
      "**/ios/Pods": true,
      "**/ios/*.xcworkspace/xcuserdata": true,
      "**/ios/*.xcodeproj/xcuserdata": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/Pods": true,
      "**/build": true,
      "**/.gradle": true,
      "**/android/app/build": true,
      "**/ios/build": true
    },
    "eslint.enable": true,
    "eslint.useFlatConfig": true,
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact"
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  }
}
